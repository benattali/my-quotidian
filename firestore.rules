rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A user owns their profile doc and its favorites subcollection.
    // Cloud Functions use the Admin SDK and bypass these rules.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Clients may only set their own known preference/token fields.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.keys()
                         .hasOnly(['notifyTime', 'timezone', 'notificationsEnabled', 'fcmToken']);
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['notifyTime', 'timezone', 'notificationsEnabled', 'fcmToken']);

      match /favorites/{quoteId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // The daily quote is readable by any signed-in user; only the backend writes it.
    match /dailyQuote/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Dedupe history is backend-only.
    match /quoteHistory/{id} {
      allow read, write: if false;
    }
  }
}
